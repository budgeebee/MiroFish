FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends docker.io \
    && rm -rf /var/lib/apt/lists/*
# Exact package set of the live mirofish-api container (2026-09-22), including
# httpx/httpcore that the pipeline imports but were only hand-installed there.
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
WORKDIR /app
COPY api_server.py .
CMD ["python3", "-m", "uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "5010"]
